{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm --prefix apps/web ci && npm --prefix apps/web run build",
  "outputDirectory": "apps/web/dist",
  "fluid": true,
  "functions": { "api/merchant.mjs": { "maxDuration": 15 } },
  "rewrites": [
    { "source": "/v1/:route*", "destination": "/api/merchant?__vishwas_route=:route*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'none'; object-src 'none'; media-src 'self' blob:" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
